{
  "uid": "pyrenex-drift",
  "title": "Pyrenex Drift — suivi dérive v2",
  "tags": [
    "pyrenex",
    "m6",
    "drift"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Comportement — probabilités prédites (médiane / p90)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "description": "Le modèle hésite-t-il plus qu'avant ? Histogramme exposé par le service model (M5) : _bucket + rate() + histogram_quantile().",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum(rate(pyrenex_prediction_proba_bucket[5m])) by (le))",
          "legendFormat": "médiane"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.9, sum(rate(pyrenex_prediction_proba_bucket[5m])) by (le))",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 2,
      "title": "Comportement — part des dossiers prédits en défaut",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "description": "La proportion de défauts annoncés a-t-elle bougé ? Compteur pyrenex_predictions_total (M5), labellé par classe prédite.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pyrenex_predictions_total{predicted_class=\"1\"}[5m])) / sum(rate(pyrenex_predictions_total[5m]))",
          "legendFormat": "part classe 1"
        }
      ]
    },
    {
      "id": 3,
      "title": "Contexte — volume et taux d'erreur",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "Y a-t-il assez de trafic pour conclure ? Une bascule de distribution sur 3 requêtes ne veut rien dire. Le volume exclut le scrape Prometheus lui-même (/metrics, /health).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=~\"model|backend\", handler!~\"/metrics|/health\"}[5m]))",
          "legendFormat": "RPS total"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=~\"model|backend\", handler!~\"/metrics|/health\", status=~\"4..|5..\"}[5m])) or vector(0)",
          "legendFormat": "erreurs 4xx/5xx"
        }
      ]
    }
  ]
}
